# Badezeit Sylt Restaurant Platform - Environment Variables
# Copy this file to .env.local for development or configure in Vercel for production

# Database Configuration (Supabase Cloud)
# ⚠️ IMPORTANTE PARA VERCEL/PRODUCCIÓN:
# - DATABASE_URL: Usa Connection Pooler (puerto 6543) con pgbouncer=true para serverless
# - DIRECT_URL: Usa conexión directa (puerto 5432) solo para migraciones locales
# Encuentra estas URLs en: Supabase Dashboard > Settings > Database > Connection Pooling
# Ver VERCEL_DATABASE_CONFIG.md para instrucciones detalladas

# Para Vercel/Producción (puerto 6543 - Connection Pooler):
DATABASE_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Para migraciones locales (puerto 5432 - Direct Connection):
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.xxx.supabase.co:5432/postgres"

# Supabase Configuration (Authentication & Database)
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
# Anon/Public key (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_key_here"

# Email Service (Resend) - REQUIRED
# Get your API key from https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY="re_your_resend_api_key_here"
# Must be verified in Resend dashboard
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Application Configuration - REQUIRED
# For development use localhost, for production use your Vercel domain
# Development:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (in Vercel, set to your actual domain):
# NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_SITE_NAME="Badezeit Sylt"

# Restaurant Configuration
RESTAURANT_EMAIL="info@badezeit-sylt.de"
RESTAURANT_PHONE="+49 4651 123456"
RESTAURANT_ADDRESS="Strandstraße 1, 25980 Sylt, Deutschland"

# Environment Mode
# For development: NODE_ENV="development"
# For production: NODE_ENV="production"
NODE_ENV="production"

# Optional: Analytics
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_VERCEL_ANALYTICS=true

# Optional: Maps Integration
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"