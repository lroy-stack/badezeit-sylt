# Badezeit Sylt Restaurant Platform - Environment Variables
# Copy this file to .env.local for development
# For production deployment, configure these in Vercel: Settings → Environment Variables

# Database Configuration (Supabase Cloud) - REQUIRED
# Get these from Supabase Project Settings → Database
# Direct connection string for migrations
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler for queries (recommended for serverless)
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase Configuration (Authentication & Database) - REQUIRED
# Get these from Supabase Project Settings → API
# URL format: https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
# Anon/Public key (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_key_here"

# Email Service (Resend) - REQUIRED
# Get your API key from https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY="re_your_resend_api_key_here"
# Must be verified in Resend dashboard
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Application Configuration - REQUIRED
# For development use localhost, for production use your Vercel domain
# Development:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (in Vercel, set to your actual domain):
# NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_SITE_NAME="Badezeit Sylt"

# Restaurant Configuration
RESTAURANT_EMAIL="info@badezeit-sylt.de"
RESTAURANT_PHONE="+49 4651 123456"
RESTAURANT_ADDRESS="Strandstraße 1, 25980 Sylt, Deutschland"

# Environment Mode
# For development: NODE_ENV="development"
# For production: NODE_ENV="production"
NODE_ENV="production"

# Optional: Analytics
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_VERCEL_ANALYTICS=true

# Optional: Maps Integration
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"